# Copy to .env and change the password. NEVER commit .env.
POSTGRES_USER=hotel
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=hotel

# Image to run. For local builds leave as-is. For a published image use e.g.
# APP_IMAGE=ghcr.io/YOUR_USERNAME/hotel-booking-cicd  and  APP_TAG=v1.0.0
APP_IMAGE=hotel-booking-api
APP_TAG=local

LOG_LEVEL=INFO
